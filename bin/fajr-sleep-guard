#!/usr/bin/env python3
"""Run the Hyprland/Wayland Fajr Sleep Guard PC lock daemon."""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent / "reference-omarchy-android"
sys.path.insert(0, str(ROOT))

from fajr_sleep_guard.pc_guard import run_guard  # noqa: E402


def main() -> int:
    ap = argparse.ArgumentParser(description="Run Fajr Sleep Guard PC lock daemon.")
    ap.add_argument(
        "--test-lock",
        type=int,
        default=0,
        help="Engage the pure-black lock for N seconds for live testing, then exit cleanly.",
    )
    args = ap.parse_args()
    return run_guard(test_seconds=args.test_lock)


if __name__ == "__main__":
    raise SystemExit(main())
